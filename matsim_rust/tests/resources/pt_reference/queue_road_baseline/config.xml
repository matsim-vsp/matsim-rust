<?xml version='1.0' encoding='UTF-8'?>
<!DOCTYPE config SYSTEM "http://www.matsim.org/files/dtd/config_v2.dtd">
<config>

	<module name="global">
		<param name="randomSeed" value="4711" />
		<param name="coordinateSystem" value="Atlantis" />
	</module>

	<module name="network">
		<param name="inputNetworkFile" value="../queue_road_common/network.xml" />
	</module>

	<module name="plans">
		<param name="inputPlansFile" value="../queue_road_common/plans_base.xml" />
	</module>

	<module name="vehicles">
		<param name="vehiclesFile" value="../queue_road_common/javaVehicles.xml" />
	</module>

	<module name="transit">
		<param name="vehiclesFile" value="../queue_road_common/transitVehicles.xml" />
		<param name="transitScheduleFile" value="../queue_road_common/schedule.xml" />
		<param name="useTransit" value="true" />
		
		<param name="usingTransitInMobsim" value="true" />
	</module>

	<module name="routing">
			
		<param name="walkSpeed" value="0.8333333333333334" />
		<param name="beelineDistanceFactor" value="1.3" />
	</module>

	<module name="qsim">
		<param name="startTime" value="0" />
		<param name="endTime" value="24:00:00" />
		<param name="timeStepSize" value="1.0" />
		<param name="insertingWaitingVehiclesBeforeDrivingVehicles" value="true" />
		<param name="removeStuckVehicles" value="false" />
		<param name="snapshotperiod" value="00:00:00" />
	</module>

	<module name="controller">
		<param name="firstIteration" value="0" />
		<param name="lastIteration" value="0" />
		<param name="outputDirectory" value="queue_road_baseline_out" />
		<param name="overwriteFiles" value="deleteDirectoryIfExists" />
		<param name="eventsFileFormat" value="xml" />
		
		<param name="compressionType" value="none" />
		<param name="writeEventsInterval" value="1" />
	</module>

	<module name="scoring">
		<parameterset type="scoringParameters">
			<parameterset type="modeParams">
				<param name="mode" value="car" />
				<param name="marginalUtilityOfTraveling_util_hr" value="-6.0" />
				<param name="marginalUtilityOfDistance_util_m" value="0.0" />
			</parameterset>
			<parameterset type="modeParams">
				<param name="mode" value="walk" />
				<param name="marginalUtilityOfTraveling_util_hr" value="-6.0" />
				<param name="marginalUtilityOfDistance_util_m" value="0.0" />
			</parameterset>
			<parameterset type="modeParams">
				<param name="mode" value="pt" />
				<param name="marginalUtilityOfTraveling_util_hr" value="-6.0" />
				<param name="marginalUtilityOfDistance_util_m" value="0.0" />
			</parameterset>
			<parameterset type="activityParams">
				<param name="activityType" value="h" />
				<param name="typicalDuration" value="12:00:00" />
			</parameterset>
			<parameterset type="activityParams">
				<param name="activityType" value="w" />
				<param name="typicalDuration" value="8:00:00" />
			</parameterset>
			<parameterset type="activityParams">
				<param name="activityType" value="s" />
				<param name="typicalDuration" value="0:40:00" />
			</parameterset>
		</parameterset>
	</module>

</config>