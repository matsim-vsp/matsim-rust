<!DOCTYPE transitSchedule SYSTEM "http://www.matsim.org/files/dtd/transitSchedule_v1.dtd">

<!--
  Routing-probe reference fixture: a direct service that a faster transfer beats.

  Stops sit on the tutorial network so this fixture reuses it:
    ra  on link 11, at the coordinates of the tutorial's stop facility 1
    rb  on link 12, at the coordinates of the tutorial's stop facility 2a, 2138 m from ra
    rc  on link 33, at the coordinates of the tutorial's stop facility 3, 2681 m from rb

  A request from ra to rc departing 08:00 has three candidates:
    a_to_b  08:00 -> 08:10 at rb
    b_to_c  08:15 -> 08:25 at rc   (5 minute transfer, above the reference's 60 s minimum)
    direct  08:00 -> 08:50 at rc

  Departures without a vehicleRefId keep the fixture runnable with teleported transit only.
-->
<transitSchedule>
	<transitStops>
		<stopFacility id="ra" x="1050" y="1050" linkRefId="11" />
		<stopFacility id="rb" x="2050" y="2940" linkRefId="12" />
		<stopFacility id="rc" x="3950" y="1050" linkRefId="33" />
	</transitStops>

	<transitLine id="Reference Line">
