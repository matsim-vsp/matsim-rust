<!DOCTYPE transitSchedule SYSTEM "http://www.matsim.org/files/dtd/transitSchedule_v1.dtd">

<!--
  Combined-feature fixture. Four optional routing features are active at the same time, so the
  fixture shows them composing rather than only working one at a time:

    1. passenger mode mapping          train -> rail, bus -> road
    2. person-specific scoring costs   `default` prefers rail, `freight` prefers road
    3. walking transfer                rb -> rb_platform, separate facilities 100 m apart
    4. transfer penalty                base cost plus a cost per hour of the journey so far

  Stops and routes follow routing_distinct_platform_transfer, with the bus given the same departure
  series as the train so both subpopulations have the same choices available.

  A request from ra to rc departing 08:00 has these candidates:
    a_to_b       train 08:00 -> 08:10 at rb
    walk         rb -> rb_platform, 130 m after the 1.3 beeline factor
    b_to_c       train 08:15 -> 08:25 at rc
    b_to_c_bus   bus   08:15 -> 08:20 at rc
    direct       train 08:00 -> 08:50 at rc

  Departures without a vehicleRefId keep the fixture runnable with teleported transit only.
-->
<transitSchedule>
	<transitStops>
		<stopFacility id="ra" x="1050" y="1050" linkRefId="11" />
		<stopFacility id="rb" x="2050" y="2940" linkRefId="12" />
		<stopFacility id="rb_platform" x="2150" y="2940" linkRefId="23" />
		<stopFacility id="rc" x="3950" y="1050" linkRefId="33" />
	</transitStops>

	<transitLine id="Reference Line">
		<transitRoute id="a_to_b">
			<transportMode>train</transportMode>
			<routeProfile>
				<stop refId="ra" departureOffset="00:00:00" />
				<stop refId="rb" arrivalOffset="00:10:00" />
			</routeProfile>
			<route>
