<?xml version="1.0" ?>
<!DOCTYPE config SYSTEM "http://www.matsim.org/files/dtd/config_v2.dtd">
<!--
  Person-specific routing cost reference fixture. Mirrors routing_mapped_modes and adds per
  subpopulation scoring so two passengers with different subpopulations pick different services.

  The Rust side runs config.yml from the same directory. Both configs pin the walk parameters the
  reference and the Rust transit router use for access and egress.
-->
<config>

	<module name="global">
		<param name="randomSeed" value="4711" />
		<param name="coordinateSystem" value="Atlantis" />
	</module>

	<module name="network">
		<param name="inputNetworkFile" value="../../../../assets/pt_tutorial/multimodalnetwork.xml" />
	</module>

	<module name="vehicles">
		<param name="vehiclesFile" value="../../../../assets/pt_tutorial/vehicles.xml" />
	</module>

	<module name="transit">
		<param name="transitScheduleFile" value="transit_schedule.xml" />
		<param name="useTransit" value="true" />
		<param name="transitModes" value="pt,rail,road" />
		<param name="usingTransitInMobsim" value="false" />
	</module>

	<module name="swissRailRaptor">
		<param name="useModeMappingForPassengers" value="true" />
		<parameterset type="modeMapping">
			<param name="routeMode" value="train" />
			<param name="passengerMode" value="rail" />
		</parameterset>
		<parameterset type="modeMapping">
			<param name="routeMode" value="bus" />
			<param name="passengerMode" value="road" />
		</parameterset>
	</module>

	<module name="scoring">
		<parameterset type="scoringParameters">
			<parameterset type="modeParams">
				<param name="mode" value="pt" />
				<param name="marginalUtilityOfTraveling_util_hr" value="-6.0" />
			</parameterset>
			<parameterset type="modeParams">
				<param name="mode" value="walk" />
				<param name="marginalUtilityOfTraveling_util_hr" value="-6.0" />
			</parameterset>
			<parameterset type="modeParams">
				<param name="mode" value="car" />
				<param name="marginalUtilityOfTraveling_util_hr" value="-6.0" />
			</parameterset>
			<parameterset type="modeParams">
				<param name="mode" value="rail" />
				<param name="marginalUtilityOfTraveling_util_hr" value="-1.0" />
			</parameterset>
			<parameterset type="modeParams">
				<param name="mode" value="road" />
				<param name="marginalUtilityOfTraveling_util_hr" value="-24.0" />
			</parameterset>
			<!-- Freight overrules rail as expensive, road as cheap: the freight passenger picks
			     the bus transfer instead of the rail direct service. -->
			<parameterset type="modeParams">
				<param name="subpopulation" value="freight" />
				<param name="mode" value="rail" />
				<param name="marginalUtilityOfTraveling_util_hr" value="-24.0" />
			</parameterset>
			<parameterset type="modeParams">
				<param name="subpopulation" value="freight" />
				<param name="mode" value="road" />
				<param name="marginalUtilityOfTraveling_util_hr" value="-1.0" />
			</parameterset>
			<parameterset type="agentParams">
				<param name="subpopulation" value="person" />
				<param name="performing" value="6.0" />
			</parameterset>
			<parameterset type="agentParams">
				<param name="subpopulation" value="freight" />
				<param name="performing" value="6.0" />
			</parameterset>
		</parameterset>
	</module>

	<module name="routing">
		<param name="walkSpeed" value="0.8333333333333334" />
		<param name="beelineDistanceFactor" value="1.3" />
	</module>

	<module name="qsim">
		<param name="startTime" value="0" />
		<param name="endTime" value="24:00:00" />
		<param name="timeStepSize" value="1.0" />
		<param name="insertingWaitingVehiclesBeforeDrivingVehicles" value="true" />
		<param name="removeStuckVehicles" value="false" />
		<param name="snapshotperiod" value="00:00:00" />
	</module>

	<module name="controller">
		<param name="firstIteration" value="0" />
		<param name="lastIteration" value="0" />
		<param name="outputDirectory" value="out" />
		<param name="overwriteFiles" value="deleteDirectoryIfExists" />
		<param name="eventsFileFormat" value="xml" />
		<param name="compressionType" value="none" />
		<param name="writeEventsInterval" value="1" />
	</module>

</config>
