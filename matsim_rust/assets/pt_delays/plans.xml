		<plan selected="yes">
			<activity type="home" link="suburb_stop" x="0" y="0" end_time="07:58:00"/>
			<leg mode="walk" dep_time="07:58:00" trav_time="00:00:00">
				<attributes><attribute name="routingMode" class="java.lang.String">pt</attribute></attributes>
				<route type="generic" start_link="suburb_stop" end_link="suburb_stop" trav_time="00:00:00" distance="0.0"></route>
			</leg>
			<activity type="pt interaction" link="suburb_stop" x="0" y="0" max_dur="00:00:00"/>
			<leg mode="pt" dep_time="07:58:00" trav_time="00:17:00">
				<attributes><attribute name="routingMode" class="java.lang.String">pt</attribute></attributes>
				<route type="default_pt" start_link="suburb_stop" end_link="center_stop" trav_time="00:17:00" distance="20000.0">{"transitRouteId":"express_suburb_center","boardingTime":"08:05:00","transitLineId":"express","accessFacilityId":"suburb","egressFacilityId":"center"}</route>
